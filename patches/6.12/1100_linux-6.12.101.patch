-static void airoha_qdma_cleanup_tx_queue(struct airoha_queue *q)
-{
-	struct airoha_eth *eth = q->qdma->eth;
-
-	spin_lock_bh(&q->lock);
-	while (q->queued) {
-		struct airoha_queue_entry *e = &q->entry[q->tail];
