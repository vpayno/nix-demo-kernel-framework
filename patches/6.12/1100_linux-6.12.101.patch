-		      FIELD_PREP(GDM_OCFQ_MASK, val));
-	airoha_fe_rmw(eth, addr, GDM_MCFQ_MASK,
-		      FIELD_PREP(GDM_MCFQ_MASK, val));
-	airoha_fe_rmw(eth, addr, GDM_BCFQ_MASK,
-		      FIELD_PREP(GDM_BCFQ_MASK, val));
-	airoha_fe_rmw(eth, addr, GDM_UCFQ_MASK,
