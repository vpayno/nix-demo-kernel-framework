-static struct notifier_block on_panic_nb = {
-	.notifier_call = con3270_notify,
-	.priority = INT_MIN + 1, /* run the callback late */
-};
-
-static struct notifier_block on_reboot_nb = {
-	.notifier_call = con3270_notify,
-	.priority = INT_MIN + 1, /* run the callback late */
-};
