-	KSMBD_TREE_CONN_STATUS_NO_USER,
-	KSMBD_TREE_CONN_STATUS_INVALID_USER,
-	KSMBD_TREE_CONN_STATUS_HOST_DENIED	= 5,
-	KSMBD_TREE_CONN_STATUS_CONN_EXIST,
-	KSMBD_TREE_CONN_STATUS_TOO_MANY_CONNS,
