-static void __exit
-exit_cifs(void)
-{
-	cifs_dbg(NOISY, "exit_smb3\n");
-	unregister_filesystem(&cifs_fs_type);
-	unregister_filesystem(&smb3_fs_type);
-	cifs_dfs_release_automount_timer();
