-		ses->iface_count++;
-		spin_unlock(&ses->iface_lock);
-		ses->iface_last_update = jiffies;
-next_iface:
-		nb_iface++;
-		next = le32_to_cpu(p->Next);
-		if (!next) {
-			bytes_left -= sizeof(*p);
-			break;
-		}
-		p = (struct network_interface_info_ioctl_rsp *)((u8 *)p+next);
