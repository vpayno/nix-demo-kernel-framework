-	ksmbd_tools_pid = 0;
-	cancel_delayed_work_sync(&ipc_timer_work);
-	mutex_unlock(&startup_lock);
-}
-
-int ksmbd_ipc_init(void)
-{
-	int ret = 0;
-
-	ksmbd_nl_init_fixup();
-	INIT_DELAYED_WORK(&ipc_timer_work, ipc_timer_heartbeat);
-
