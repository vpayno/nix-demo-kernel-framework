-
-		entry->response = kvmalloc(sz, GFP_KERNEL | __GFP_ZERO);
-		if (!entry->response) {
-			ret = -ENOMEM;
-			break;
-		}
-
-		memcpy(entry->response, payload, sz);
-		wake_up_interruptible(&entry->wait);
-		ret = 0;
