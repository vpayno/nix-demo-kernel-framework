-	__u16	status;
-	__u16	hash_sz;			/* hash size */
-	__s8	hash[KSMBD_REQ_MAX_HASH_SZ];	/* password hash */
-	__u32	reserved[16];			/* Reserved room */
-};
-
-/*
- * IPC request to fetch net share config.
