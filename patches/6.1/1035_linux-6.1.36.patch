new file mode 100644
index 0000000000000..1237bb86e93a8
--- /dev/null
+++ b/fs/smb/client/smb2pdu.h
@@ -0,0 +1,434 @@
+/* SPDX-License-Identifier: LGPL-2.1 */
+/*
