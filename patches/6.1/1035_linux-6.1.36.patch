-static void
-cifs_echo_callback(struct mid_q_entry *mid)
-{
-	struct TCP_Server_Info *server = mid->callback_data;
-	struct cifs_credits credits = { .value = 1, .instance = 0 };
-
-	release_mid(mid);
-	add_credits(server, &credits, CIFS_ECHO_OP);
