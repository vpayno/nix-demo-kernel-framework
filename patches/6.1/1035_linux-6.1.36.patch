-static int smb3_get_tree_common(struct fs_context *fc)
-{
-	struct smb3_fs_context *ctx = smb3_fc2context(fc);
-	struct dentry *root;
-	int rc = 0;
-
-	root = cifs_smb3_do_mount(fc->fs_type, 0, ctx);
-	if (IS_ERR(root))
-		return PTR_ERR(root);
-
-	fc->root = root;
-
-	return rc;
-}
