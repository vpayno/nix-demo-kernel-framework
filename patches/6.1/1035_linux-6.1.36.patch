-#define NTLMSSP_REQUEST_ACCEPT_RESP   0x200000 /* reserved5 */
-#define NTLMSSP_REQUEST_NON_NT_KEY    0x400000
-#define NTLMSSP_NEGOTIATE_TARGET_INFO 0x800000
