-	mutex_lock(&server->_srv_mutex);
-	server->nofs_flag = nofs_flag;
-}
-
-static inline void cifs_server_unlock(struct TCP_Server_Info *server)
-{
-	unsigned int nofs_flag = server->nofs_flag;
