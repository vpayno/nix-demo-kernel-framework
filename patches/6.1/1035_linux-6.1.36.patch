-static bool fd_limit_depleted(void)
-{
-	long v = atomic_long_dec_return(&fd_limit);
-
-	if (v >= 0)
-		return false;
-	atomic_long_inc(&fd_limit);
-	return true;
-}
-
-static void fd_limit_close(void)
-{
-	atomic_long_inc(&fd_limit);
