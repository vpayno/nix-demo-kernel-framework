-	smb_hdr_len = be32_to_cpu(pSMB->hdr.smb_buf_length) + 1;
-	if (wct == 14)
-		inc_rfc1001_len(pSMB, count + 1);
-	else /* wct == 12 */
-		inc_rfc1001_len(pSMB, count + 5); /* smb data starts later */
-	if (wct == 14)
