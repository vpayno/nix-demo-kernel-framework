-	if (!has_file_id(id)) {
-		id = work->compound_fid;
-		pid = work->compound_pfid;
-	}
-
-	fp = __ksmbd_lookup_fd(&work->sess->file_table, id);
-	if (!__sanity_check(work->tcon, fp)) {
-		ksmbd_fd_put(work, fp);
-		return NULL;
-	}
-	if (fp->persistent_id != pid) {
-		ksmbd_fd_put(work, fp);
-		return NULL;
-	}
-	return fp;
