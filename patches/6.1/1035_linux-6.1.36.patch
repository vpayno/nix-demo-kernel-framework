-static int smb3_simple_fallocate_write_range(unsigned int xid,
-					     struct cifs_tcon *tcon,
-					     struct cifsFileInfo *cfile,
-					     loff_t off, loff_t len,
-					     char *buf)
-{
-	struct cifs_io_parms io_parms = {0};
