-static const __le16 smb2_req_struct_sizes[NUMBER_OF_SMB2_COMMANDS] = {
-	/* SMB2_NEGOTIATE */ cpu_to_le16(36),
-	/* SMB2_SESSION_SETUP */ cpu_to_le16(25),
