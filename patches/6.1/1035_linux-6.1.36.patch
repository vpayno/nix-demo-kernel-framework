-	in_data.file_offset = cpu_to_le64(start);
-	in_data.length = cpu_to_le64(len);
-
-	rc = SMB2_ioctl(xid, tcon, cfile->fid.persistent_fid,
-			cfile->fid.volatile_fid,
-			FSCTL_QUERY_ALLOCATED_RANGES,
