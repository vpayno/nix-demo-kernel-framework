-/* release iface when last ref is dropped */
-static inline void
-release_iface(struct kref *ref)
-{
-	struct cifs_server_iface *iface = container_of(ref,
-						       struct cifs_server_iface,
-						       refcount);
-	list_del_init(&iface->iface_head);
-	kfree(iface);
-}
