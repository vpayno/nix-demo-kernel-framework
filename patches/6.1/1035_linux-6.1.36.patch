-	    server->ops->need_neg(server)) {
-		spin_unlock(&server->srv_lock);
-		/* No need to send echo on newly established connections */
-		mod_delayed_work(cifsiod_wq, &server->reconnect, 0);
-		return rc;
-	}
-	spin_unlock(&server->srv_lock);
-
-	rc = smb2_plain_req_init(SMB2_ECHO, NULL, server,
-				 (void **)&req, &total_len);
