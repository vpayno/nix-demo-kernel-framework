-		    sk->sk_daddr != udp_cfg->peer_ip.s_addr)
-			return false;
-		else
-			return true;
-#if IS_ENABLED(CONFIG_IPV6)
-	} else {
-		if (ipv6_addr_cmp(&sk->sk_v6_rcv_saddr, &udp_cfg->local_ip6) ||
-		    ipv6_addr_cmp(&sk->sk_v6_daddr, &udp_cfg->peer_ip6))
